# Copy to /etc/caddy/Caddyfile, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Replace mcp.example.com with your public hostname. If Caddy runs in Docker,
# use a reachable host gateway instead of 127.0.0.1; see docs/PUBLIC_HTTPS.md.
# This forwards every path, including /mcp and the OAuth discovery, token, and
# login paths. If you merge it into an existing site, add the OAuth path routes
# shown in docs/OAUTH.md before the catch-all redirect.

mcp.example.com {
    reverse_proxy 127.0.0.1:8000 {
        # Streamable HTTP can keep responses open; do not buffer them.
        flush_interval -1
    }
}
