# Copy to /etc/stpt-mcp.env, owned by root:root and mode 0600.
# Generate a static token with: stpt-mcp token
# Never commit real credentials.

# Static bearer token. Also used as the OAuth login password when
# STPT_MCP_OAUTH_PASSWORD is not set.
STPT_MCP_AUTH_TOKEN=REPLACE_ME

# Optional built-in OAuth 2.1 sign-in for hosted clients. Requires HTTPS.
# STPT_MCP_PUBLIC_URL=https://mcp.example.com
# STPT_MCP_OAUTH_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
